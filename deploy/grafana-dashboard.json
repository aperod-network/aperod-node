      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(aperod_api_http_requests_total[5m]))",
          "legendFormat": "всего"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(aperod_api_http_requests_total{status=~\"2..\"}[5m]))",
          "legendFormat": "2xx"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(aperod_api_http_requests_total{status=~\"4..\"}[5m]))",
          "legendFormat": "4xx"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(aperod_api_http_requests_total{status=~\"5..\"}[5m]))",
          "legendFormat": "5xx"
        }
