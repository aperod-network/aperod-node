{
  "title": "Aperod (APRO) — Node Overview",
  "uid": "aperod-node-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "15s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Chain Height",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "aperod_chain_height", "legendFormat": "height" }]
    },
    {
      "id": 2,
      "title": "Mempool Size",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "aperod_mempool_size", "legendFormat": "mempool" }]
    },
    {
      "id": 3,
      "title": "Connected Peers",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "targets": [{ "expr": "aperod_peer_count", "legendFormat": "peers" }]
    },
    {
      "id": 4,
      "title": "Node Up",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "targets": [{ "expr": "aperod_up", "legendFormat": "up" }]
    },
    {
      "id": 5,
      "title": "Chain Height Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [{ "expr": "aperod_chain_height", "legendFormat": "height" }]
    },
    {
      "id": 6,
      "title": "Active vs Total Validators",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        { "expr": "aperod_validator_count_active", "legendFormat": "active" },
        { "expr": "aperod_validator_count_total", "legendFormat": "total" }
      ]
    },
    {
      "id": 7,
      "title": "API Server — Requests/sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "targets": [{ "expr": "rate(aperod_api_http_requests_total[5m])", "legendFormat": "{{route}} {{status}}" }]
    },
    {
      "id": 8,
      "title": "Daily Payout Job Outcomes",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "targets": [{ "expr": "aperod_daily_payout_last_run_success", "legendFormat": "last run success (1/0)" }]
    },

    {
      "id": 20,
      "title": "— Посещения (Nginx)",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "collapsed": false
    },
    {
      "id": 21,
      "title": "Запросов в секунду (nginx)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" }
        }
      },
      "targets": [
        { "expr": "rate(nginx_http_requests_total[5m])", "legendFormat": "requests/s" }
      ]
    },
    {
      "id": 22,
      "title": "Активные соединения nginx",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "palette-classic" } }
      },
      "targets": [
        { "expr": "nginx_connections_active", "legendFormat": "active" },
        { "expr": "nginx_connections_waiting", "legendFormat": "waiting" },
        { "expr": "nginx_connections_reading + nginx_connections_writing", "legendFormat": "r+w" }
      ]
    },

    {
      "id": 30,
      "title": "— Нагрузка сервера",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 31 },
      "collapsed": false
    },
    {
      "id": 31,
      "title": "CPU %",
      "type": "gauge",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 32 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "red", "value": 85 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "cpu"
        }
      ]
    },
    {
      "id": 32,
      "title": "RAM %",
      "type": "gauge",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 32 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100",
          "legendFormat": "ram"
        }
      ]
    },
    {
      "id": 33,
      "title": "Диск %",
      "type": "gauge",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 32 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "(1 - (node_filesystem_avail_bytes{mountpoint=\"/\",fstype!=\"tmpfs\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!=\"tmpfs\"})) * 100",
          "legendFormat": "disk /"
        }
      ]
    },
    {
      "id": 34,
      "title": "CPU история",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 39 },
      "fieldConfig": { "defaults": { "unit": "percent" } },
      "targets": [
        {
          "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "cpu %"
        }
      ]
    },
    {
      "id": 35,
      "title": "Сетевой трафик (входящий/исходящий)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 39 },
      "fieldConfig": { "defaults": { "unit": "Bps" } },
      "targets": [
        { "expr": "rate(node_network_receive_bytes_total{device=\"eth0\"}[5m])", "legendFormat": "входящий" },
        { "expr": "rate(node_network_transmit_bytes_total{device=\"eth0\"}[5m])", "legendFormat": "исходящий" }
      ]
    },

    {
      "id": 40,
      "title": "— Безопасность",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 47 },
      "collapsed": false
    },
    {
      "id": 41,
      "title": "HTTP 4xx (ошибки клиента) /сек",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 48 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "fixedColor": "orange", "mode": "fixed" }
        }
      },
      "targets": [
        {
          "expr": "rate(aperod_api_http_requests_total{status=~\"4..\"}[5m])",
          "legendFormat": "4xx {{route}}"
        }
      ]
    },
    {
      "id": 42,
      "title": "HTTP 5xx (ошибки сервера) /сек",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 48 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "fixedColor": "red", "mode": "fixed" }
        }
      },
      "targets": [
        {
          "expr": "rate(aperod_api_http_requests_total{status=~\"5..\"}[5m])",
          "legendFormat": "5xx {{route}}"
        }
      ]
    },
    {
      "id": 43,
      "title": "Неудачные соединения nginx (dropped)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 56 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "fixedColor": "red", "mode": "fixed" } } },
      "targets": [
        { "expr": "rate(nginx_connections_accepted[5m]) - rate(nginx_connections_handled[5m])", "legendFormat": "dropped/s" }
      ]
    },
    {
      "id": 44,
      "title": "Load Average (1m / 5m / 15m)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 56 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        { "expr": "node_load1", "legendFormat": "1m" },
        { "expr": "node_load5", "legendFormat": "5m" },
        { "expr": "node_load15", "legendFormat": "15m" }
      ]
    }
  ]
}
