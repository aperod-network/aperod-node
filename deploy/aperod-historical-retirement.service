[Unit]
Description=Aperod exact off-host archive and verified historical copy retirement
After=local-fs.target network-online.target aperod-backup.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/bin/aperod-rollout-cleanup retirement-scan
EnvironmentFile=-/etc/aperod/backup-secrets.env
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
Nice=19
IOSchedulingClass=idle
CPUQuota=40%
MemoryMax=600M
ProtectSystem=strict
ReadOnlyPaths=/opt/aperod/data
ReadWritePaths=/var/lib/aperod-rollout-cleanup /opt/aperod/releases
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
NoNewPrivileges=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_FOWNER CAP_SYS_PTRACE
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardOutput=journal
StandardError=journal
TimeoutStartSec=2h
