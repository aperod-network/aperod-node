# =============================================================================
#  aperod-node-watchdog.service — one-shot health probe for the Go node API
#
#  Triggered periodically by aperod-node-watchdog.timer (default: every 60 s).
#  If GET /api/v1/status does not return HTTP 200 within 5 s the script
#  calls `systemctl restart aperod-node`.
#
#  Deploy (run as root after copying all three watchdog files):
#    sudo cp blockchain/deploy/aperod-node-watchdog.sh  /usr/local/bin/
#    sudo chmod +x /usr/local/bin/aperod-node-watchdog.sh
#    sudo cp blockchain/deploy/aperod-node-watchdog.service /etc/systemd/system/
#    sudo cp blockchain/deploy/aperod-node-watchdog.timer   /etc/systemd/system/
#    sudo cp blockchain/deploy/aperod-watchdog-set-interval.sh /usr/local/bin/aperod-watchdog-set-interval
#    sudo chmod +x /usr/local/bin/aperod-watchdog-set-interval
#    sudo systemctl daemon-reload
#    sudo systemctl enable --now aperod-node-watchdog.timer
#
#  To change the probe interval without a redeploy:
#    Edit /etc/aperod/watchdog.env  →  set WATCHDOG_INTERVAL_SECS=<seconds>
#    Then run: sudo aperod-watchdog-set-interval
# =============================================================================

[Unit]
Description=Aperod node API watchdog (one-shot probe)
# Must run after the node itself is available
After=aperod-node.service
# A probe failure is not fatal for the watchdog unit itself
IgnoreOnIsolate=yes

[Service]
Type=oneshot
# Run as root so it can call `systemctl restart aperod-node`
User=root

# Load optional site-local overrides (bot token, custom URL, interval, etc.)
EnvironmentFile=-/etc/aperod/watchdog.env

Environment=NODE_API_URL=http://127.0.0.1:8545
Environment=TIMEOUT_SECS=5
# Default probe interval (seconds) — overridden by watchdog.env.
# Changing WATCHDOG_INTERVAL_SECS in watchdog.env takes effect after
# running `sudo aperod-watchdog-set-interval`.
Environment=WATCHDOG_INTERVAL_SECS=60
# RAM threshold in MB above which the node is proactively restarted even
# when the API is healthy.  Prevents OOM-induced SIGKILL and LevelDB
# corruption.  Set to 0 to disable RAM-based restarts.
# Override in /etc/aperod/watchdog.env: RAM_THRESHOLD_MB=<value>
Environment=RAM_THRESHOLD_MB=4800
# Number of consecutive no-new-block probes before the node is restarted.
# Catches silent freezes where the process is alive and API responds but block
# production has stalled (e.g. CPU-saturated GC loop).  At a 45 s interval,
# 3 checks = ~135 s of frozen height before restart.  Set to 0 to disable.
Environment=STALL_CHECKS_MAX=3
Environment=WATCHDOG_INTERVAL_SECS=45

ExecStart=/usr/local/bin/aperod-node-watchdog.sh

# Give the script enough time: curl timeout (5 s) + systemctl restart margin
TimeoutStartSec=30

StandardOutput=journal
StandardError=journal
SyslogIdentifier=aperod-node-watchdog

# Minimal sandboxing — needs to reach localhost and call systemctl
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
