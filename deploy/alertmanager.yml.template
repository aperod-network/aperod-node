global:
  resolve_timeout: 5m

route:
  receiver: aperod-admin-telegram
  group_by: ["alertname", "service", "severity"]
  group_wait: 15s
  group_interval: 5m
  repeat_interval: 4h

receivers:
  - name: aperod-admin-telegram
    telegram_configs:
      - bot_token_file: /etc/alertmanager/telegram-bot-token
        chat_id: __ADMIN_TELEGRAM_CHAT_ID__
        send_resolved: true
        parse_mode: HTML
        message: |-
          {{ if eq .Status "firing" }}🚨 <b>Алерт Aperod Mainnet</b>{{ else }}✅ <b>Алерт Aperod Mainnet закрыт</b>{{ end }}
          {{ range .Alerts }}
          <b>{{ .Annotations.summary }}</b>
          {{ .Annotations.description }}
          Серьёзность: {{ .Labels.severity }}
          {{ end }}
